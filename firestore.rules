rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().systemRole == 'admin';
    }

    // Users collection
    match /users/{userId} {
      // Any authenticated user can read user profiles (needed for assignees, team rosters, avatars)
      allow read: if isAuthenticated();
      
      // User can create their own profile during registration, default systemRole is 'user'
      // Admins can create any profile
      allow create: if isAuthenticated() && (
        (isUser(userId) && request.resource.data.systemRole == 'user') ||
        isAdmin()
      );
      
      // User can update their own profile, but CANNOT modify systemRole
      // Admin can update any profile including systemRole
      allow update: if isAuthenticated() && (
        (isUser(userId) && request.resource.data.systemRole == resource.data.systemRole) ||
        isAdmin()
      );
      
      // Only admins can delete user documents
      allow delete: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      // Authenticated users can read tasks (required for queries across assignees, creators, and teams)
      allow read: if isAuthenticated();
      
      // Authenticated users can create tasks
      allow create: if isAuthenticated();
      
      // Authenticated users (assignees, creators, admins) can update task status and toggle checklist items
      allow update: if isAuthenticated();
      
      // Only admins can delete tasks
      allow delete: if isAdmin();
    }

    // Activity Logs collection
    match /activityLogs/{logId} {
      // Authenticated users can read activity logs to view platform activity and task audit trails
      allow read: if isAuthenticated();
      
      // Authenticated users can create activity logs with their own userId or actor info
      allow create: if isAuthenticated();
      
      // Activity logs are immutable except by admins
      allow update, delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Any authenticated user can send/create notifications (e.g. task assignments)
      allow create: if isAuthenticated();
      
      // Users can update their own notifications (e.g. mark as read)
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      
      // Users can delete their own notifications, admins can delete any
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }
  }
}
